APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_FAST=gpt-5.5-mini
OPENAI_MODEL_STRONG=gpt-5.5
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL_FAST=gpt-5.4-mini
OPENAI_FALLBACK_MODEL_STRONG=gpt-5.4-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# AWS S3 bucket used for uploaded documents, generated memos, and investor audio.
# Example endpoint for eu-south-1: https://s3.eu-south-1.amazonaws.com
S3_ENDPOINT=https://s3.eu-south-1.amazonaws.com
S3_REGION=eu-south-1
S3_BUCKET=spinout-engine-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=

MAX_UPLOAD_MB=20
ENABLE_DEMO_FIXTURES=true
SAVE_AUDIO_TO_S3=true
